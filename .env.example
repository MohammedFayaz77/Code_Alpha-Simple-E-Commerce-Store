# Fayaz Event Management (CodeAlpha Project Management Tool)
# Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# Local Windows zero-config SQLite:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production / Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fayaz_event_db?schema=public"

# Authentication Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Frontend Client Origin
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
